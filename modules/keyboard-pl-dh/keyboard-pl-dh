#!/bin/bash
# Summary: Polish Colemak-DH on the desktop and at the boot passphrase prompt.
set -euo pipefail

# Resolve symlinks so the command works through ~/.local/bin/keyboard-pl-dh.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
  source_path="$(readlink -- "$source_path")"
  [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
done
script_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
repo_dir="$(cd -P -- "$script_dir/../.." && pwd)"

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omasetup/keyboard-pl-dh"
root_state_dir="${KEYBOARD_PL_DH_ROOT_STATE:-/var/lib/omasetup/keyboard-pl-dh}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
layouts_file="$config_dir/omarchy/keyboard-layouts"
menu_file="$config_dir/omarchy/extensions/omarchy-menu.jsonc"
symbols_file="$config_dir/xkb/symbols/pl"
symbols_stock=/usr/share/X11/xkb/symbols/pl
helper="$script_dir/system.sh"
picker_script="$script_dir/picker.py"

# The desktop gets two layouts: Polish Colemak-DH first, plain Polish QWERTY
# second. The boot screen always gets Polish Colemak-DH, whatever the desktop
# is set to.
layout='pl,pl'
variant='colemak_dh,'
boot_keymap='mod-dh-iso-us'

menu_begin='// omasetup:keyboard-pl-dh begin'
menu_end='// omasetup:keyboard-pl-dh end'

# The bar label comes from the compiled keymap's name, so a user copy of the
# Polish symbols file renames just the ISO Colemak-DH variant. xkbcli still
# reads the stock description from evdev.extras.xml, which is what makes the
# bar fall back to the first word: COL instead of the shared PL brief.
symbols_name='Colemak-DH (PL)'
symbols_stock_name='Polish (Colemak-DH ISO)'
symbols_marker='Generated by keyboard-pl-dh'

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
Usage: keyboard-pl-dh <command>

Commands:
  enable [--yes]  Set the desktop layout, add the menu override, and set the
                  boot keymap. The boot part asks for confirmation and sudo.
  desktop         Set the desktop layout only. No sudo.
  picker          Open Omarchy's keyboard layout picker with a readable name
                  for Polish Colemak-DH. Used by the menu override.
  verify          Check that the boot image contains the boot keymap. Uses sudo.
  disable         Undo everything, including the boot keymap.
  status          Show the desktop layout, the bar labels, the boot keymap,
                  and the menu override.
  link            Put the keyboard-pl-dh command on your PATH.
  unlink          Remove that command.
  update          Update this checkout.
  version         Show the installed version.

The desktop layout is a per-user file. The boot keymap is /etc/vconsole.conf,
which is baked into the boot image. Changing the layout in the Omarchy menu
changes only the desktop, never the boot screen.

Examples:
  keyboard-pl-dh status
  keyboard-pl-dh enable
  keyboard-pl-dh desktop
  keyboard-pl-dh verify
  keyboard-pl-dh disable
EOF
  exit "$code"
}

if [ "$(id -u)" -eq 0 ]; then
  echo "keyboard-pl-dh: Run as your normal user, not as root." >&2
  exit 1
fi

hyprland_running() {
  command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1
}

reload_hyprland() {
  hyprland_running || return 1
  hyprctl reload >/dev/null 2>&1 || return 1
}

runtime_option() {
  hyprctl getoption "$1" 2>/dev/null | sed -n 's/^str: //p' | head -n 1
}

runtime_layout() {
  runtime_option input:kb_layout
}

runtime_variant() {
  runtime_option input:kb_variant
}

file_option() {
  local file=$1 key=$2
  [ -f "$file" ] || return 1
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

desktop_written() {
  [ "$(file_option "$layouts_file" XKBLAYOUT 2>/dev/null || true)" = "$layout" ] &&
    [ "$(file_option "$layouts_file" XKBVARIANT 2>/dev/null || true)" = "$variant" ]
}

desktop_running() {
  case "$(runtime_layout)" in
    pl | pl,*) ;;
    *) return 1 ;;
  esac
  case "$(runtime_variant)" in
    colemak_dh | colemak_dh,*) ;;
    *) return 1 ;;
  esac
}

layouts_backup="$state_dir/keyboard-layouts.before"
layouts_absent="$state_dir/keyboard-layouts.absent"
menu_absent="$state_dir/omarchy-menu.absent"
symbols_backup="$state_dir/xkb-pl.before"
symbols_absent="$state_dir/xkb-pl.absent"

backup_layouts() {
  [ -f "$layouts_backup" ] && return 0
  [ -f "$layouts_absent" ] && return 0
  mkdir -p -- "$state_dir"
  if [ -f "$layouts_file" ]; then
    cp -a -- "$layouts_file" "$layouts_backup"
  else
    : >"$layouts_absent"
  fi
}

write_layouts() {
  local tmp
  mkdir -p -- "$(dirname -- "$layouts_file")"
  tmp=$(mktemp -- "$(dirname -- "$layouts_file")/.keyboard-layouts.XXXXXX") || {
    echo "keyboard-pl-dh: The layout file could not be created in $(dirname -- "$layouts_file")." >&2
    return 1
  }
  {
    grep -vE '^(XKBLAYOUT|XKBVARIANT)=' "$layouts_file" 2>/dev/null || true
    printf 'XKBLAYOUT=%s\n' "$layout"
    printf 'XKBVARIANT=%s\n' "$variant"
  } >"$tmp" || {
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: The layout file could not be written." >&2
    return 1
  }
  chmod 0644 -- "$tmp"
  mv -fT -- "$tmp" "$layouts_file" || {
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: The layout file could not be installed." >&2
    return 1
  }
}

restore_layouts() {
  local tmp
  if [ -f "$layouts_backup" ]; then
    mkdir -p -- "$(dirname -- "$layouts_file")"
    tmp=$(mktemp -- "$(dirname -- "$layouts_file")/.keyboard-layouts.XXXXXX") || return 1
    cp -a -- "$layouts_backup" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    mv -fT -- "$tmp" "$layouts_file" || {
      rm -f -- "$tmp"
      return 1
    }
    rm -f -- "$layouts_backup"
  elif [ -f "$layouts_absent" ]; then
    rm -f -- "$layouts_file"
    rm -f -- "$layouts_absent"
  fi
}

symbols_installed() {
  [ -f "$symbols_file" ] && grep -qF "name[Group1]= \"$symbols_name\"" "$symbols_file"
}

backup_symbols() {
  [ -f "$symbols_backup" ] && return 0
  [ -f "$symbols_absent" ] && return 0
  mkdir -p -- "$state_dir"
  if [ -f "$symbols_file" ]; then
    cp -a -- "$symbols_file" "$symbols_backup"
  else
    : >"$symbols_absent"
  fi
}

# A generated file carries a marker so a later enable regenerates it from the
# current stock file. A file without the marker belongs to the user and is
# renamed in place, then restored by disable.
symbols_source() {
  if [ -s "$symbols_file" ] && ! head -n 1 -- "$symbols_file" | grep -qF -- "$symbols_marker"; then
    printf '%s\n' "$symbols_file"
  else
    printf '%s\n' "$symbols_stock"
  fi
}

write_symbols() {
  local source tmp validate
  if [ ! -f "$symbols_stock" ]; then
    echo "keyboard-pl-dh: $symbols_stock is missing, so the bar label was not changed." >&2
    return 0
  fi

  backup_symbols
  source=$(symbols_source)
  mkdir -p -- "$(dirname -- "$symbols_file")"
  tmp=$(mktemp -- "$(dirname -- "$symbols_file")/.pl.XXXXXX") || {
    echo "keyboard-pl-dh: The symbols file could not be created in $(dirname -- "$symbols_file")." >&2
    return 1
  }
  {
    if [ "$source" = "$symbols_stock" ]; then
      printf '// %s from %s. Re-run "keyboard-pl-dh enable" after xkeyboard-config updates.\n' \
        "$symbols_marker" "$symbols_stock"
    fi
    sed -E "s/name\\[Group1\\][[:space:]]*=[[:space:]]*\"Polish \\(Colemak-DH ISO\\)\"/name[Group1]= \"$symbols_name\"/" "$source"
  } >"$tmp" || {
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: The symbols file could not be written." >&2
    return 1
  }

  if ! grep -qF "name[Group1]= \"$symbols_name\"" "$tmp"; then
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: WARNING: $source has no \"$symbols_stock_name\" name to rename." >&2
    echo "keyboard-pl-dh: WARNING: the bar will show PL for both layouts." >&2
    return 0
  fi

  # Validate before touching the live file: a broken symbols file would break
  # every application that compiles a keymap, not just the bar label.
  if command -v xkbcli >/dev/null 2>&1; then
    validate=$(mktemp -d) || {
      rm -f -- "$tmp"
      return 1
    }
    mkdir -p -- "$validate/xkb/symbols"
    cp -- "$tmp" "$validate/xkb/symbols/pl"
    if ! XDG_CONFIG_HOME="$validate" xkbcli compile-keymap --layout pl --variant colemak_dh --test >/dev/null 2>&1 ||
      ! XDG_CONFIG_HOME="$validate" xkbcli compile-keymap --layout pl --test >/dev/null 2>&1; then
      rm -rf -- "$validate"
      rm -f -- "$tmp"
      echo "keyboard-pl-dh: The generated pl symbols file does not compile, so it was not installed." >&2
      return 1
    fi
    rm -rf -- "$validate"
  fi

  chmod 0644 -- "$tmp"
  mv -fT -- "$tmp" "$symbols_file" || {
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: The symbols file could not be installed." >&2
    return 1
  }
}

restore_symbols() {
  local tmp
  if [ -f "$symbols_backup" ]; then
    mkdir -p -- "$(dirname -- "$symbols_file")"
    tmp=$(mktemp -- "$(dirname -- "$symbols_file")/.pl.XXXXXX") || return 1
    cp -a -- "$symbols_backup" "$tmp" || {
      rm -f -- "$tmp"
      return 1
    }
    mv -fT -- "$tmp" "$symbols_file" || {
      rm -f -- "$tmp"
      return 1
    }
    rm -f -- "$symbols_backup"
  elif [ -f "$symbols_absent" ]; then
    rm -f -- "$symbols_file"
    rm -f -- "$symbols_absent"
  fi
  rmdir -- "$(dirname -- "$symbols_file")" 2>/dev/null || true
  rmdir -- "$config_dir/xkb" 2>/dev/null || true
}

menu_has_begin() {
  [ -f "$menu_file" ] && grep -qF -- "$menu_begin" "$menu_file"
}

menu_has_end() {
  [ -f "$menu_file" ] && grep -qF -- "$menu_end" "$menu_file"
}

menu_installed() {
  menu_has_begin && menu_has_end
}

# Omarchy merges a user row over its own by id, but it normalizes the user row
# first, so a missing label becomes the id. The override must repeat the stock
# label. Read it from the menu catalog for the current language, the same table
# the shell applies to the stock rows, and fall back to English.
menu_label() {
  local lang catalog label
  lang=
  if [ -f "$config_dir/omarchy/language" ]; then
    lang=$(tr -d '[:space:]' <"$config_dir/omarchy/language")
  fi
  [ -n "$lang" ] || lang=en
  label=
  for catalog in "$OMARCHY_PATH/default/i18n/$lang/menu.json" \
    "$OMARCHY_PATH/default/i18n/en/menu.json"; do
    [ -f "$catalog" ] || continue
    label=$(python3 - "$catalog" <<'PY' 2>/dev/null || true
import json
import sys

try:
    entry = json.load(open(sys.argv[1])).get("setup.typing.keyboard") or {}
except Exception:
    entry = {}
print(entry.get("label", ""))
PY
)
    [ -n "$label" ] && break
  done
  printf '%s\n' "${label:-Keyboard Layouts}"
}

# The same normalization resets the icon, so the override repeats the stock
# one too. Read it from Omarchy's default menu so a change there is picked up.
menu_icon() {
  local menu="$OMARCHY_PATH/default/omarchy/omarchy-menu.jsonc" icon=
  if [ -f "$menu" ]; then
    icon=$(python3 - "$menu" <<'PY' 2>/dev/null || true
import json
import re
import sys

text = open(sys.argv[1]).read()
text = re.sub(r"^\s*//[^\n]*(\n|$)", "", text, flags=re.M)
text = re.sub(r",(\s*[}\]])", r"\1", text)
try:
    entry = json.loads(text).get("setup.typing.keyboard") or {}
except Exception:
    entry = {}
print(entry.get("icon", ""))
PY
)
  fi
  printf '%s\n' "$icon"
}

menu_block() {
  local label icon
  label=$(menu_label)
  icon=$(menu_icon)
  label=$(printf '%s' "$label" | sed 's/\\/\\\\/g; s/"/\\"/g')
  icon=$(printf '%s' "$icon" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '  %s\n' "$menu_begin"
  printf '  // Added by the keyboard-pl-dh module. Removed by "keyboard-pl-dh disable".\n'
  printf '  "setup.typing.keyboard": {"icon":"%s","label":"%s","action":"keyboard-pl-dh picker"},\n' "$icon" "$label"
  printf '  %s\n' "$menu_end"
}

menu_strip_block() {
  awk -v begin="$menu_begin" -v end="$menu_end" '
    index($0, begin) { skip = 1 }
    !skip { print }
    index($0, end) { skip = 0 }
  '
}

menu_add() {
  local n tmp stripped
  if [ -f "$menu_file" ] && { menu_has_begin || menu_has_end; } && ! menu_installed; then
    echo "keyboard-pl-dh: $menu_file has only one marker, so it was not changed." >&2
    return 1
  fi

  if [ ! -f "$menu_file" ]; then
    mkdir -p -- "$(dirname -- "$menu_file")" "$state_dir"
    : >"$menu_absent"
    printf '{\n}\n' >"$menu_file"
  fi

  stripped=$(mktemp -- "$(dirname -- "$menu_file")/.omarchy-menu.XXXXXX") || return 1
  if menu_installed; then
    menu_strip_block <"$menu_file" >"$stripped" || {
      rm -f -- "$stripped"
      return 1
    }
  else
    cp -- "$menu_file" "$stripped" || {
      rm -f -- "$stripped"
      return 1
    }
  fi

  n=$(grep -n -m 1 -E '^[[:space:]]*\{[[:space:]]*$' "$stripped" | cut -d: -f1 || true)
  if [ -z "$n" ]; then
    rm -f -- "$stripped"
    echo "keyboard-pl-dh: $menu_file does not start with a JSON object, so the menu row was not added." >&2
    return 1
  fi

  tmp=$(mktemp -- "$(dirname -- "$menu_file")/.omarchy-menu.XXXXXX") || {
    rm -f -- "$stripped"
    return 1
  }
  {
    head -n "$n" "$stripped"
    menu_block
    tail -n +"$((n + 1))" "$stripped"
  } >"$tmp" || {
    rm -f -- "$stripped" "$tmp"
    return 1
  }
  rm -f -- "$stripped"

  # A second enable rewrites the same block; leave the file untouched then.
  if cmp -s -- "$tmp" "$menu_file"; then
    rm -f -- "$tmp"
    return 0
  fi

  chmod --reference="$menu_file" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
  mv -fT -- "$tmp" "$menu_file" || {
    rm -f -- "$tmp"
    echo "keyboard-pl-dh: The menu row could not be added." >&2
    return 1
  }
}

menu_remove() {
  local tmp
  if ! menu_has_begin && ! menu_has_end; then
    return 0
  fi
  if ! menu_installed; then
    echo "keyboard-pl-dh: $menu_file has only one marker, so it was not changed." >&2
    return 1
  fi

  tmp=$(mktemp -- "$(dirname -- "$menu_file")/.omarchy-menu.XXXXXX") || return 1
  menu_strip_block <"$menu_file" >"$tmp" || {
    rm -f -- "$tmp"
    return 1
  }

  if ! cmp -s -- "$tmp" "$menu_file"; then
    chmod --reference="$menu_file" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
    mv -fT -- "$tmp" "$menu_file" || {
      rm -f -- "$tmp"
      echo "keyboard-pl-dh: The menu row could not be removed." >&2
      return 1
    }
  fi
  rm -f -- "$tmp"

  # If the module created the file and nothing else was added to it, remove it.
  if [ -f "$menu_absent" ]; then
    if [ -z "$(tr -d '[:space:]{}' <"$menu_file")" ]; then
      rm -f -- "$menu_file"
    fi
    rm -f -- "$menu_absent"
  fi
}

refresh_menu() {
  command -v omarchy >/dev/null 2>&1 || return 0
  omarchy menu refresh >/dev/null 2>&1 || true
}

boot_on() {
  [ -f "$state_dir/boot-on" ] || [ -f "$root_state_dir/active" ]
}

boot_install() {
  if [ ! -f "$helper" ]; then
    echo "keyboard-pl-dh: The root helper is missing from $script_dir." >&2
    return 1
  fi
  if ! sudo "$helper" install; then
    echo "keyboard-pl-dh: The boot keymap was not installed." >&2
    return 1
  fi
  mkdir -p -- "$state_dir"
  : >"$state_dir/boot-on"
  chmod 0644 -- "$state_dir/boot-on"
}

boot_uninstall() {
  if [ ! -f "$helper" ]; then
    echo "keyboard-pl-dh: The root helper is missing from $script_dir." >&2
    return 1
  fi
  if ! sudo "$helper" uninstall; then
    echo "keyboard-pl-dh: The boot keymap was not removed." >&2
    return 1
  fi
  rm -f -- "$state_dir/boot-on"
}

confirm_boot() {
  local answer
  if [ ! -r /dev/tty ]; then
    echo "keyboard-pl-dh: No terminal is available for confirmation. The boot keymap was not changed." >&2
    echo "keyboard-pl-dh: Run 'keyboard-pl-dh enable --yes' to change it." >&2
    return 1
  fi
  cat >&2 <<EOF
The boot passphrase prompt will use Polish Colemak-DH ($boot_keymap).
Colemak-DH moves letters and punctuation, so the passphrase is typed in new
positions. The desktop is not affected.

Before rebooting, test it in a TTY:
  sudo loadkeys $boot_keymap
  nano /tmp/passphrase-test
Type the passphrase and compare it with what you expect.

A failed unlock can be recovered with a live USB. Keep one nearby.

EOF
  printf 'Continue? [y/N] ' >&2
  read -r answer </dev/tty || return 1
  case "$answer" in
    y | Y | yes | YES) return 0 ;;
    *) return 1 ;;
  esac
}

desktop_apply() {
  backup_layouts
  write_symbols || return 1
  write_layouts

  if hyprland_running; then
    if ! reload_hyprland; then
      echo "keyboard-pl-dh: Hyprland is running but the reload failed, so the new layouts were not applied." >&2
      return 1
    fi
    if desktop_running; then
      echo "The desktop uses Polish Colemak-DH, then Polish QWERTY."
    else
      echo "keyboard-pl-dh: Hyprland did not report the new layouts. Log in again." >&2
      return 1
    fi
  else
    echo "The desktop uses Polish Colemak-DH, then Polish QWERTY, at the next login."
  fi
  echo "  Switch layouts with the layout indicator on the bar: COL and PL."
}

enable() {
  local assume_yes=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --yes | -y)
        assume_yes=1
        shift
        ;;
      *)
        usage
        ;;
    esac
  done

  desktop_apply
  menu_add
  refresh_menu

  if ! command -v keyboard-pl-dh >/dev/null 2>&1; then
    echo "keyboard-pl-dh: WARNING: keyboard-pl-dh is not on PATH, so the" >&2
    echo "keyboard-pl-dh: WARNING: Setup > Typing > Keyboard Layouts cannot open the picker." >&2
    echo "keyboard-pl-dh: WARNING: run 'keyboard-pl-dh link' and log in again." >&2
  fi

  if boot_on; then
    echo "The boot passphrase prompt already uses $boot_keymap."
    echo "  To check the boot image, run 'keyboard-pl-dh verify'."
  elif [ "$assume_yes" -eq 1 ] || confirm_boot; then
    boot_install
    echo "The boot passphrase prompt now uses $boot_keymap."
  else
    echo "The boot passphrase prompt was not changed."
    echo "  To change it later, run 'keyboard-pl-dh enable --yes'."
  fi

  echo
  echo "  To see the state, run 'keyboard-pl-dh status'."
  echo "  To undo everything, run 'keyboard-pl-dh disable'."
}

disable() {
  local boot_failed=0

  if boot_on; then
    if ! boot_uninstall; then
      boot_failed=1
    fi
  fi

  menu_remove
  refresh_menu

  restore_symbols
  restore_layouts
  if hyprland_running; then
    if reload_hyprland; then
      echo "The desktop layout and bar labels were restored."
    else
      echo "keyboard-pl-dh: The desktop layout was restored on disk, but the Hyprland reload failed." >&2
    fi
  else
    echo "The desktop layout will be restored at the next login."
  fi

  rm -f -- "$state_dir/boot-on"
  rmdir -- "$state_dir" 2>/dev/null || true
  if [ "$boot_failed" -eq 1 ]; then
    echo "keyboard-pl-dh: The desktop was restored, but the boot keymap was not fully restored; see above." >&2
    return 1
  fi
  echo "The keyboard-pl-dh module is off."
}

print_status() {
  local current_layout current_variant menu_state bar_state

  echo "keyboard-pl-dh"
  echo

  current_layout=$(file_option "$layouts_file" XKBLAYOUT 2>/dev/null || true)
  current_variant=$(file_option "$layouts_file" XKBVARIANT 2>/dev/null || true)
  if [ "$current_layout" = "$layout" ] && [ "$current_variant" = "$variant" ]; then
    echo "  Desktop          Polish Colemak-DH, then Polish QWERTY."
  elif [ -n "$current_layout" ]; then
    echo "  Desktop          $current_layout (${current_variant:-no variant})."
  else
    echo "  Desktop          The Omarchy default."
  fi

  if hyprland_running; then
    if desktop_running; then
      echo "  Running now      Hyprland is using the PL Colemak-DH list."
    else
      echo "  Running now      Hyprland is using $(runtime_layout || echo 'the default')."
    fi
  else
    echo "  Running now      Hyprland is not running."
  fi

  echo "  Boot keymap      $(file_option /etc/vconsole.conf KEYMAP 2>/dev/null || echo unknown)"

  bar_state=no
  symbols_installed && bar_state=yes
  if [ "$bar_state" = yes ]; then
    echo "  Bar labels       Colemak-DH is COL; Polish QWERTY is PL."
  else
    echo "  Bar labels       Both layouts show PL."
  fi

  menu_state=no
  menu_installed && menu_state=yes
  if [ "$menu_state" = yes ]; then
    echo "  Menu             Setup > Typing > Keyboard Layouts opens the picker."
  else
    echo "  Menu             The stock keyboard picker."
  fi

  if boot_on; then
    echo "  State            The module is on."
  elif desktop_written || menu_installed || [ "$bar_state" = yes ]; then
    echo "  State            The desktop part is on; the boot part is off."
  else
    echo "  State            The module is off."
  fi
}

version() {
  if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'keyboard-pl-dh %s\n' \
      "$(git -C "$repo_dir" describe --tags --always --dirty 2>/dev/null || echo "unknown: git describe failed.")"
  else
    echo "keyboard-pl-dh unknown: this is not a git checkout."
  fi
}

update() {
  if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "keyboard-pl-dh: This is not a git checkout. Download a fresh copy instead." >&2
    exit 1
  fi

  git -C "$repo_dir" pull --ff-only
  version
}

picker() {
  if [ ! -f "$picker_script" ]; then
    echo "keyboard-pl-dh: $picker_script is missing." >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "keyboard-pl-dh: python3 is missing, so the picker cannot open." >&2
    exit 1
  fi
  if [ "$#" -eq 0 ]; then
    set -- keyboard
  fi
  exec python3 "$picker_script" "$@"
}

verify_boot() {
  if [ ! -f "$helper" ]; then
    echo "keyboard-pl-dh: The root helper is missing from $script_dir." >&2
    exit 1
  fi
  sudo "$helper" verify "$@"
}

link_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/keyboard-pl-dh"

  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "keyboard-pl-dh: $link already exists and is not a symlink, so keyboard-pl-dh will not overwrite it." >&2
    exit 1
  fi
  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" != "$script_dir/keyboard-pl-dh" ]; then
    echo "keyboard-pl-dh: $link points to another checkout, so keyboard-pl-dh will not overwrite it." >&2
    exit 1
  fi

  mkdir -p -- "$bin_dir"
  ln -sfn -- "$script_dir/keyboard-pl-dh" "$link"
  echo "Linked $link to $script_dir/keyboard-pl-dh."

  case ":$PATH:" in
    *":$bin_dir:"*) echo "Run 'keyboard-pl-dh enable' to turn it on." ;;
    *) echo "Warning: $bin_dir is not on your PATH. Add it, or run $script_dir/keyboard-pl-dh directly." >&2 ;;
  esac
}

unlink_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/keyboard-pl-dh"

  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" = "$script_dir/keyboard-pl-dh" ]; then
    rm -f -- "$link"
    echo "Removed $link."
  elif [ -e "$link" ]; then
    echo "keyboard-pl-dh: $link does not point at this checkout, so keyboard-pl-dh will not remove it." >&2
    exit 1
  else
    echo "There is no link at $link."
  fi
}

case "${1:-}" in
  enable)
    shift
    enable "$@"
    ;;
  desktop)
    desktop_apply
    ;;
  picker)
    shift
    picker "$@"
    ;;
  verify)
    shift
    verify_boot "$@"
    ;;
  disable)
    disable
    ;;
  status)
    if [ "${2:-}" = "--quiet" ]; then
      boot_on
    else
      print_status
    fi
    ;;
  link)
    link_command
    ;;
  unlink)
    unlink_command
    ;;
  update)
    update
    ;;
  version | --version)
    version
    ;;
  -h | --help | help)
    usage 0
    ;;
  *)
    usage
    ;;
esac
