#!/bin/bash
# Omatweaks: small, reversible tweaks for Omarchy.
set -euo pipefail

# Resolve symlinks so `omatweaks` works through ~/.local/bin/omatweaks.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
  source_path="$(readlink -- "$source_path")"
  [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
done
repo_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"

usage() {
  cat >&2 <<'EOF'
Usage: omatweaks <command>

Commands:
  list                  List available tweaks
  <tweak> enable        Enable a tweak
  <tweak> disable       Disable a tweak
  <tweak> status        Show a tweak's state
  link                  Link the omatweaks command into ~/.local/bin
  unlink                Remove that link
  update                Update this checkout
  version               Show the installed version
EOF
  exit 2
}

if [ "$(id -u)" -eq 0 ]; then
  echo "omatweaks: run as your normal user, not root." >&2
  exit 1
fi

feature_script() {
  local name="$1"
  case "$name" in
    ''|*[!a-z0-9-]*|[!a-z0-9]*)
      echo "omatweaks: invalid tweak name: $name" >&2
      return 1
      ;;
  esac

  local script="$repo_dir/$name/$name.sh"
  if [ ! -f "$script" ]; then
    echo "omatweaks: unknown tweak: $name" >&2
    return 1
  fi

  printf '%s\n' "$script"
}

list_features() {
  local dir name summary found=0
  for dir in "$repo_dir"/*/; do
    name="$(basename -- "$dir")"
    [ -f "$dir/$name.sh" ] || continue
    summary="$(sed -n 's/^# Summary: //p' "$dir/$name.sh" | head -n 1)"
    printf '  %-18s %s\n' "$name" "$summary"
    found=1
  done
  [ "$found" -eq 1 ] || echo "  (no tweaks found)"
}

version() {
  if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$repo_dir" describe --tags --always --dirty 2>/dev/null || echo "unknown"
  else
    echo "unknown (not a git checkout)"
  fi
}

update() {
  if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "omatweaks: not a git checkout; download a fresh copy instead." >&2
    exit 1
  fi

  git -C "$repo_dir" pull --ff-only
  printf 'omatweaks %s\n' "$(version)"
}

link_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/omatweaks"

  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "omatweaks: $link already exists and is not a symlink; refusing to overwrite." >&2
    exit 1
  fi
  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" != "$repo_dir/omatweaks" ]; then
    echo "omatweaks: $link points elsewhere; refusing to overwrite." >&2
    exit 1
  fi

  mkdir -p -- "$bin_dir"
  ln -sfn -- "$repo_dir/omatweaks" "$link"
  echo "Linked $link -> $repo_dir/omatweaks"

  case ":$PATH:" in
    *":$bin_dir:"*) echo "Run: omatweaks list" ;;
    *) echo "Warning: $bin_dir is not in PATH; add it or use $repo_dir/omatweaks." >&2 ;;
  esac
}

unlink_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/omatweaks"

  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" = "$repo_dir/omatweaks" ]; then
    rm -f -- "$link"
    echo "Removed $link"
  elif [ -e "$link" ]; then
    echo "omatweaks: $link does not point at this checkout; not removing." >&2
    exit 1
  else
    echo "No link at $link."
  fi
}

case "${1:-}" in
  ""|-h|--help|help)
    usage
    ;;
  list)
    list_features
    ;;
  link)
    link_command
    ;;
  unlink)
    unlink_command
    ;;
  update)
    update
    ;;
  version|--version)
    version
    ;;
  *)
    feature="$1"
    action="${2:-}"

    case "$action" in
      enable|disable|status) ;;
      *) usage ;;
    esac

    script="$(feature_script "$feature")" || exit 1
    shift 2
    exec "$script" "$action" "$@"
    ;;
esac
