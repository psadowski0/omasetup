#!/bin/bash
# Omatweaks: small, reversible tweaks for Omarchy.
set -euo pipefail

# Resolve symlinks so `omatweaks` works through ~/.local/bin/omatweaks.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
  source_path="$(readlink -- "$source_path")"
  [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
done
repo_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
Usage: omatweaks <command>

Small, reversible tweaks for Omarchy.

Commands:
  list                  List the available tweaks.
  <tweak> enable        Turn a tweak on.
  <tweak> disable       Turn a tweak off and remove its files.
  <tweak> status        Show what a tweak is doing.
  link                  Put the omatweaks command on your PATH.
  unlink                Remove that command.
  update                Update this checkout.
  version               Show the installed version.

Examples:
  omatweaks list
  omatweaks auto-hibernate enable
  omatweaks auto-hibernate status
EOF
  exit "$code"
}

if [ "$(id -u)" -eq 0 ]; then
  echo "omatweaks: Run as your normal user, not as root." >&2
  exit 1
fi

feature_script() {
  local name="$1"
  case "$name" in
    ''|*[!a-z0-9-]*|[!a-z0-9]*)
      echo "omatweaks: \"$name\" is not a valid tweak name." >&2
      return 1
      ;;
  esac

  local script="$repo_dir/tweaks/$name/$name.sh"
  if [ ! -f "$script" ]; then
    echo "omatweaks: There is no tweak named \"$name\"." >&2
    return 1
  fi

  printf '%s\n' "$script"
}

list_features() {
  local dir name script summary state found=0
  echo "Available tweaks:"
  for dir in "$repo_dir"/tweaks/*/; do
    [ -d "$dir" ] || continue
    name="$(basename -- "$dir")"
    script="$dir/$name.sh"
    [ -f "$script" ] || continue

    summary="$(sed -n 's/^# Summary: //p' "$script" | head -n 1)"
    if "$script" status --quiet >/dev/null 2>&1; then
      state="enabled"
    else
      state="disabled"
    fi

    printf '  %-16s %-9s %s\n' "$name" "$state" "$summary"
    found=1
  done
  [ "$found" -eq 1 ] || echo "  No tweaks were found."
}

version() {
  if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$repo_dir" describe --tags --always --dirty 2>/dev/null || echo "unknown: git describe failed."
  else
    echo "unknown: this is not a git checkout."
  fi
}

update() {
  if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "omatweaks: This is not a git checkout. Download a fresh copy instead." >&2
    exit 1
  fi

  git -C "$repo_dir" pull --ff-only
  printf 'omatweaks %s\n' "$(version)"
}

link_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/omatweaks"

  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "omatweaks: $link already exists and is not a symlink, so omatweaks will not overwrite it." >&2
    exit 1
  fi
  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" != "$repo_dir/omatweaks" ]; then
    echo "omatweaks: $link points to another checkout, so omatweaks will not overwrite it." >&2
    exit 1
  fi

  mkdir -p -- "$bin_dir"
  ln -sfn -- "$repo_dir/omatweaks" "$link"
  echo "Linked $link to $repo_dir/omatweaks."

  case ":$PATH:" in
    *":$bin_dir:"*) echo "Run 'omatweaks list' to see what is available." ;;
    *) echo "Warning: $bin_dir is not on your PATH. Add it, or run $repo_dir/omatweaks directly." >&2 ;;
  esac
}

unlink_command() {
  local bin_dir link
  bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
  link="$bin_dir/omatweaks"

  if [ -L "$link" ] && [ "$(readlink -f -- "$link")" = "$repo_dir/omatweaks" ]; then
    rm -f -- "$link"
    echo "Removed $link."
  elif [ -e "$link" ]; then
    echo "omatweaks: $link does not point at this checkout, so omatweaks will not remove it." >&2
    exit 1
  else
    echo "There is no link at $link."
  fi
}

case "${1:-}" in
  "")
    usage
    ;;
  -h|--help|help)
    usage 0
    ;;
  list)
    list_features
    ;;
  link)
    link_command
    ;;
  unlink)
    unlink_command
    ;;
  update)
    update
    ;;
  version|--version)
    version
    ;;
  *)
    feature="$1"
    action="${2:-}"

    case "$action" in
      enable|disable|status) ;;
      *) usage ;;
    esac

    script="$(feature_script "$feature")" || exit 1
    shift 2
    exec "$script" "$action" "$@"
    ;;
esac
